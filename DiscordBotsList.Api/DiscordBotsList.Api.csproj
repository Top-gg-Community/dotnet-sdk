<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Authors>Velddev, Faith</Authors>
        <Company>Top.gg</Company>
        <Description>Top.gg API wrapper for .NET. Supports the current v1 API (projects, votes, metrics, announcements, commands) with webhook signature verification, plus the legacy v0 API.</Description>
        <Copyright>Mike Veldsink</Copyright>
        <PackageProjectUrl>https://github.com/top-gg-community/dotnet-sdk</PackageProjectUrl>
        <RepositoryUrl>https://github.com/top-gg-community/dotnet-sdk</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>discord bots topgg api wrapper webhooks</PackageTags>
        <PackageReleaseNotes>Add Top.gg v1 API client, webhook signature verification (HMAC SHA-256) and webhook event models; fix legacy v0 authentication (raw token, no Bearer prefix).</PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <AssemblyName>DiscordBotsList.Api</AssemblyName>
        <RootNamespace>DiscordBotsList.Api</RootNamespace>
        <Product>DiscordBotsList.Api</Product>
        <Version>1.7.0</Version>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Text.Json" Version="9.0.9" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DiscordBotsList.Api.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\LICENSE">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

</Project>
